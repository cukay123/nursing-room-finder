# Production Environment Variables
# Copy this file to .env.production and fill in your values

# Supabase Configuration (use hosted Supabase for production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Node Environment
NODE_ENV=production

# Next.js Configuration
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Required. Protects /admin and /api/admin/*. Without it the admin surface
# returns 503 for everything — it fails closed by design.
ADMIN_PASSWORD=choose-a-long-random-string
