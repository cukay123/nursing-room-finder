# Production environment variables.
#
# These four are the complete set — the app reads nothing else. On a host like
# Railway, Render or Fly, set them as service variables rather than committing a
# file. NODE_ENV is already set to production inside the Dockerfile.

# Supabase (use a hosted project for production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# OneMap postal code lookups
NEXT_PUBLIC_ONEMAP_API_URL=https://www.onemap.gov.sg/api/common/elastic/search

# Required. Protects /admin and /api/admin/*. Without it the admin surface
# returns 503 for everything — it fails closed by design. Use a long random
# string, and not the one from your local .env.local.
ADMIN_PASSWORD=choose-a-long-random-string

# Do NOT set SUPABASE_ACCESS_TOKEN here. That token controls the whole Supabase
# account and is only needed locally for `supabase link` / `supabase db push`.
# The running app never uses it.
