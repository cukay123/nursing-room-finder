# OPTION 1: LOCAL DEVELOPMENT (Supabase CLI + Docker)
# After running: supabase start
# Copy the URL and key from: supabase status
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-from-supabase-status

# OPTION 2: HOSTED DEVELOPMENT (Supabase Cloud)
# Get credentials from: https://app.supabase.com
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# OneMap API (for postal code → lat/lng lookups)
NEXT_PUBLIC_ONEMAP_API_URL=https://www.onemap.gov.sg/api/common/elastic/search

# Mapbox token (unused for now, using Leaflet/OSM instead)
# NEXT_PUBLIC_MAPBOX_TOKEN=your_token

# Required. Protects /admin and /api/admin/*. Without it the admin surface
# returns 503 for everything — it fails closed by design.
ADMIN_PASSWORD=choose-a-long-random-string
